<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Werkbord</string>
	<key>CFBundleDisplayName</key>
	<string>Werkbord</string>
	<key>CFBundleExecutable</key>
	<string>Werkbord</string>
	<key>CFBundleIdentifier</key>
	<string>dev.werkbord.desktop</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>CFBundleIconFile</key>
	<string>icon</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Werkbord runs on your own computer.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<!-- A Team invitation (werkbord://join/…) opens here and is handed to the shell, which sets up the workspace it is for. -->
			<key>CFBundleURLName</key>
			<string>dev.werkbord.desktop.join</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>werkbord</string>
			</array>
		</dict>
	</array>
	<!-- Dictation in the assistant (the microphone button in its message box). The web view asks macOS on the app's behalf, and macOS
	     refuses silently, or ends the app, when these are missing. The microphone is opened only while dictation is on. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Werkbord listens only while you use dictation in the assistant, to turn what you say into text in its message box.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Werkbord uses Apple’s speech recognition to turn what you say into text when you use dictation in the assistant.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The window loads the controller's web app from 127.0.0.1, over plain HTTP: it never leaves this computer. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
