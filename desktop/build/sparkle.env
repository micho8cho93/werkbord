# Sparkle (https://sparkle-project.org), the framework that replaces the app in place. The version is pinned and so is the
# SHA-256 of the release archive: scripts/fetch-sparkle.sh refuses anything else, so a changed download can never become
# part of an update. To move to another version: change all three lines, then run `make desktop-package` and
# `make test-desktop-update` (and read Sparkle's changelog: https://github.com/sparkle-project/Sparkle/releases).
SPARKLE_VERSION=2.10.0
SPARKLE_SHA256=c2bf58aa8387266ac179357b1415d6f2635f044da8be41042af32425dae6da0c
SPARKLE_URL=https://github.com/sparkle-project/Sparkle/releases/download/2.10.0/Sparkle-2.10.0.tar.xz
