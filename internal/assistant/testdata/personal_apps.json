  {
    "name": "Engineering Decision Log",
    "prompt": "Create Engineering Decision Log in Individual with Decisions, Documentation, Relationships.",
    "change": {
      "workspace": {
        "name": "Engineering Decision Log",
        "icon": "auto",
        "uiSchemaVersion": 1,
        "visibility": {
          "universal": false,
          "individual": true,
          "teamWorkspaceIds": []
        },
        "collectionIds": [
          "records"
        ],
        "readBindings": [],
        "definition": {
          "views": [
            {
              "id": "decisions",
              "name": "Decisions",
              "kind": "table",
              "collectionId": "records",
              "fields": [
                "title",
                "status",
                "impact",
                "confidence",
                "score"
              ],
              "operations": [
                "create",
                "update",
                "delete"
              ],
              "actions": [
                {
                  "id": "accept",
                  "name": "Accept decision",
                  "when": [
                    {
                      "field": "status",
                      "value": "Proposed"
                    }
                  ],
                  "steps": [
                    {
                      "operation": "update",
                      "values": {
                        "status": "Accepted"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "documentation",
              "name": "Documentation",
              "kind": "pages",
              "collectionId": "records",
              "fields": [
                "title",
                "status"
              ],
              "bodyField": "body",
              "parentField": "parent",
              "operations": [
                "create",
                "update",
                "delete"
              ]
            },
            {
              "id": "relationships",
              "name": "Relationships",
              "kind": "hierarchy",
              "collectionId": "records",
              "fields": [
                "title"
              ],
              "parentField": "parent"
            }
          ],
          "layout": {
            "type": "stack",
            "children": [
              {
                "type": "view",
                "viewId": "decisions"
              },
              {
                "type": "view",
                "viewId": "documentation"
              },
              {
                "type": "view",
                "viewId": "relationships"
              }
            ]
          }
        }
      },
      "collections": [
        {
          "id": "records",
          "revision": 0,
          "spec": {
            "name": "Engineering Decision Log records",
            "schemaVersion": 1,
            "fields": [
              {
                "key": "title",
                "name": "Title",
                "type": "text",
                "required": true
              },
              {
                "key": "status",
                "name": "Status",
                "type": "select",
                "options": [
                  "Proposed",
                  "Accepted"
                ]
              },
              {
                "key": "impact",
                "name": "Impact",
                "type": "number",
                "min": 1,
                "max": 5,
                "input": "rating"
              },
              {
                "key": "confidence",
                "name": "Confidence",
                "type": "number",
                "min": 1,
                "max": 5,
                "input": "slider"
              },
              {
                "key": "score",
                "name": "Score",
                "type": "number",
                "formula": {
                  "op": "multiply",
                  "args": [
                    {
                      "op": "field",
                      "field": "impact"
                    },
                    {
                      "op": "field",
                      "field": "confidence"
                    }
                  ]
                }
              },
              {
                "key": "body",
                "name": "Body",
                "type": "longtext"
              },
              {
                "key": "parent",
                "name": "Parent",
                "type": "text"
              }
            ]
          }
        }
      ]
    },
    "values": {
      "title": "Illustrative architecture choice",
      "status": "Proposed",
      "impact": 4,
      "confidence": 3,
      "body": "Alternatives and scoring rationale"
    }
  },
  {
    "name": "Personal Productivity Dashboard",
    "prompt": "Create Personal Productivity Dashboard in Individual with Tasks, Calendar, Progress, Notes, Reminders.",
    "change": {
      "workspace": {
        "name": "Personal Productivity Dashboard",
        "icon": "auto",
        "uiSchemaVersion": 1,
        "visibility": {
          "universal": false,
          "individual": true,
          "teamWorkspaceIds": []
        },
        "collectionIds": [
          "records"
        ],
        "readBindings": [],
        "definition": {
          "views": [
            {
              "id": "tasks",
              "name": "Tasks",
              "kind": "checklist",
              "collectionId": "records",
              "fields": [
                "title",
                "due",
                "reminder"
              ],
              "checkedField": "done",
              "operations": [
                "create",
                "update",
                "delete"
              ],
              "actions": [
                {
                  "id": "dismiss",
                  "name": "Dismiss reminder",
                  "steps": [
                    {
                      "operation": "update",
                      "values": {
                        "reminder": false
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "calendar",
              "name": "Calendar",
              "kind": "calendar",
              "collectionId": "records",
              "fields": [
                "title"
              ],
              "dateField": "due"
            },
            {
              "id": "progress",
              "name": "Progress",
              "kind": "progress",
              "collectionId": "records",
              "fields": [
                "title"
              ],
              "checkedField": "done"
            },
            {
              "id": "notes",
              "name": "Notes",
              "kind": "document",
              "collectionId": "records",
              "fields": [
                "title"
              ],
              "bodyField": "notes",
              "operations": [
                "create",
                "update",
                "delete"
              ]
            },
            {
              "id": "reminders",
              "name": "Reminders",
              "kind": "list",
              "collectionId": "records",
              "fields": [
                "title",
                "due"
              ],
              "visibleWhen": [
                {
                  "field": "reminder",
                  "value": "true"
                }
              ],
              "filters": [
                {
                  "field": "reminder",
                  "value": "true"
                }
              ]
            }
          ],
          "layout": {
            "type": "stack",
            "children": [
              {
                "type": "view",
                "viewId": "tasks"
              },
              {
                "type": "view",
                "viewId": "calendar"
              },
              {
                "type": "view",
                "viewId": "progress"
              },
              {
                "type": "view",
                "viewId": "notes"
              },
              {
                "type": "view",
                "viewId": "reminders"
              }
            ]
          }
        }
      },
      "collections": [
        {
          "id": "records",
          "revision": 0,
          "spec": {
            "name": "Personal Productivity Dashboard records",
            "schemaVersion": 1,
            "fields": [
              {
                "key": "title",
                "name": "Title",
                "type": "text",
                "required": true
              },
              {
                "key": "done",
                "name": "Done",
                "type": "boolean"
              },
              {
                "key": "due",
                "name": "Due",
                "type": "date"
              },
              {
                "key": "reminder",
                "name": "Reminder",
                "type": "boolean"
              },
              {
                "key": "last_reminded",
                "name": "Last Reminded",
                "type": "datetime"
              },
              {
                "key": "notes",
                "name": "Notes",
                "type": "longtext"
              }
            ],
            "rules": [
              {
                "id": "daily_reminder",
                "when": [
                  {
                    "field": "done",
                    "value": "false"
                  }
                ],
                "set": {
                  "reminder": true
                },
                "schedule": {
                  "dateField": "due",
                  "lastRunField": "last_reminded",
                  "everyDays": 1
                }
              }
            ]
          }
        }
      ]
    },
    "values": {
      "title": "Illustrative recurring task",
      "done": false,
      "due": "2026-10-24",
      "notes": "Personal notes"
    }
  }
]
