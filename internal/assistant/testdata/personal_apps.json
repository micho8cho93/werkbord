[
  {
    "name": "Sales CRM",
    "prompt": "Create Sales CRM in Individual with Leads, Pipeline, Follow Ups, Potential Revenue.",
    "change": {
      "workspace": {
        "name": "Sales CRM",
        "icon": "auto",
        "uiSchemaVersion": 1,
        "visibility": {
          "universal": false,
          "individual": true,
          "teamWorkspaceIds": []
        },
        "collectionIds": [
          "records"
        ],
        "readBindings": [],
        "definition": {
          "views": [
            {
              "id": "leads",
              "name": "Leads",
              "kind": "table",
              "collectionId": "records",
              "fields": [
                "name",
                "stage",
                "revenue",
                "probability",
                "weighted",
                "follow_up"
              ],
              "operations": [
                "create",
                "update",
                "delete"
              ],
              "actions": [
                {
                  "id": "contact",
                  "name": "Mark contacted",
                  "steps": [
                    {
                      "operation": "update",
                      "values": {
                        "stage": "Contacted"
                      }
                    }
                  ]
                },
                {
                  "id": "summary",
                  "name": "Summarise pipeline",
                  "prompt": "Summarise the active sales pipeline and recommend follow-ups.",
                  "steps": []
                }
              ]
            },
            {
              "id": "pipeline",
              "name": "Pipeline",
              "kind": "board",
              "collectionId": "records",
              "fields": [
                "name",
                "revenue"
              ],
              "groupBy": "stage",
              "operations": [
                "create",
                "update",
                "delete"
              ]
            },
            {
              "id": "follow_ups",
              "name": "Follow Ups",
              "kind": "calendar",
              "collectionId": "records",
              "fields": [
                "name",
                "stage"
              ],
              "dateField": "follow_up"
            },
            {
              "id": "potential_revenue",
              "name": "Potential Revenue",
              "kind": "metric",
              "collectionId": "records",
              "fields": [
                "revenue"
              ],
              "metric": {
                "operation": "sum",
                "field": "revenue"
              }
            }
          ],
          "layout": {
            "type": "stack",
            "children": [
              {
                "type": "view",
                "viewId": "leads"
              },
              {
                "type": "view",
                "viewId": "pipeline"
              },
              {
                "type": "view",
                "viewId": "follow_ups"
              },
              {
                "type": "view",
                "viewId": "potential_revenue"
              }
            ]
          }
        }
      },
      "collections": [
        {
          "id": "records",
          "revision": 0,
          "spec": {
            "name": "Sales CRM records",
            "schemaVersion": 1,
            "fields": [
              {
                "key": "name",
                "name": "Name",
                "type": "text",
                "required": true
              },
              {
                "key": "stage",
                "name": "Stage",
                "type": "select",
                "options": [
                  "New",
                  "Contacted",
                  "Won"
                ]
              },
              {
                "key": "revenue",
                "name": "Revenue",
                "type": "number",
                "min": 0
              },
              {
                "key": "probability",
                "name": "Probability",
                "type": "number",
                "min": 0,
                "max": 1
              },
              {
                "key": "weighted",
                "name": "Weighted",
                "type": "number",
                "formula": {
                  "op": "multiply",
                  "args": [
                    {
                      "op": "field",
                      "field": "revenue"
                    },
                    {
                      "op": "field",
                      "field": "probability"
                    }
                  ]
                }
              },
              {
                "key": "follow_up",
                "name": "Follow Up",
                "type": "date"
              }
            ]
          }
        }
      ]
    },
    "values": {
      "name": "Illustrative lead",
      "stage": "New",
      "revenue": 1200,
      "probability": 0.5,
      "follow_up": "2026-11-01"
    }
  },
